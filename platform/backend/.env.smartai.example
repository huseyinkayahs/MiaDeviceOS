# FactoryBox One v6.5.0 SmartAI
# OpenAI is optional. Without it, FactoryBox Rule Engine remains fully usable.
SMARTAI_OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Report delivery reuses Notification Settings / existing environment values:
# TELEGRAM_ESCALATION_ENABLED=true
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# EMAIL_REPORTS_ENABLED=true
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# REPORT_EMAIL_TO=
