# FactoryBox One v6.1.2 - System Health / Docker PostgreSQL Backup settings
# Copy only the values you need into platform/backend/.env.

# Backup files are written to this Windows folder.
FACTORYBOX_BACKUP_DIR=C:\New DeviceOs Project\Backups

# PostgreSQL runs in Docker on this installation.
FACTORYBOX_POSTGRES_CONTAINER=factorybox-postgres
FACTORYBOX_POSTGRES_INTERNAL_HOST=127.0.0.1
FACTORYBOX_POSTGRES_INTERNAL_PORT=5432

# Host-side database connection used by the FactoryBox backend.
PGHOST=localhost
PGPORT=5433
PGDATABASE=factorybox
PGUSER=factorybox
PGPASSWORD=factorybox_dev_pass

# Optional: only needed when docker.exe is not available through PATH.
# DOCKER_CLI_PATH=C:\Program Files\Docker\Docker\resources\bin\docker.exe

# Optional local PostgreSQL tools. Leave these unset when Docker backup is used.
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\17\bin\pg_dump.exe
# PG_RESTORE_PATH=C:\Program Files\PostgreSQL\17\bin\pg_restore.exe

# MQTT production connection must be explicitly configured.
MQTT_URL=mqtt://localhost:1883
MQTT_BASE_TOPIC=mia/site01/laser01
MQTT_HEALTH_STALE_SEC=180
