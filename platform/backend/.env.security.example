# FactoryBox v6.2.0 Security Hardening
# Bu dosyayı doğrudan kullanmayın; gerekli satırları mevcut .env dosyanıza ekleyin.

# Gerçek müşteri ortamında açık olmalı.
AUTH_ENABLED=true

# Mevcut admin şifresini her backend açılışında .env değeriyle EZMEZ.
# Yalnızca bilinçli bir acil sıfırlama sırasında true yapın, backend'i bir kez
# başlatın ve ardından tekrar false yapın.
FACTORYBOX_ADMIN_SYNC_PASSWORD=false

# Farklı bir web alanından API erişimi gerekiyorsa virgülle ayırın.
# Aynı bilgisayar / aynı IP üzerinden kullanımda boş bırakılabilir.
# CORS_ALLOWED_ORIGINS=http://192.168.1.50:3100,https://factorybox.example.com

# Güvenlik politikası değerleri Admin Panel > Sistem Ayarları >
# Güvenlik ve Oturumlar ekranından yönetilir.
