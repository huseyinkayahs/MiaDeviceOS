FACTORYBOX_IMAGE_TAG=v6.7.0
FACTORYBOX_DEPLOYMENT_MODE=local
FACTORYBOX_DOMAIN=localhost
FACTORYBOX_PUBLIC_URL=https://localhost:8443
FACTORYBOX_HTTP_PORT=8080
FACTORYBOX_HTTPS_PORT=8443
CORS_ALLOWED_ORIGINS=https://localhost:8443,http://localhost:8080
TZ=Europe/Istanbul

# Cloud Access / Cloudflare Tunnel
REMOTE_ACCESS_ENABLED=false
REMOTE_ACCESS_MODE=disabled
REMOTE_PUBLIC_URL=
CLOUDFLARE_TUNNEL_TOKEN=

AUTH_ENABLED=true
SIGNUP_ENABLED=false
PASSWORD_RESET_ENABLED=true
FACTORYBOX_ADMIN_EMAIL=admin@factorybox.local
FACTORYBOX_ADMIN_PASSWORD=CHANGE_ME
FACTORYBOX_ADMIN_ROLE=owner
FACTORYBOX_ADMIN_SYNC_PASSWORD=false

PGDATABASE=factorybox
PGUSER=factorybox
PGPASSWORD=CHANGE_ME

MQTT_USERNAME=factorybox
MQTT_PASSWORD=CHANGE_ME
MQTT_PUBLIC_PORT=1883
MQTT_BASE_TOPIC=factorybox

CUSTOMER_CODE=first-company
CUSTOMER_NAME=First Company
SITE_CODE=main-site
SITE_NAME=Main Factory
MACHINE_CODE=machine01
MACHINE_NAME=Machine-01
MACHINE_TYPE=general
DEVICE_UID=device01
DEVICE_MODEL=FactoryBox One

FACTORYBOX_BACKUP_DIR=/app/backups
PG_DUMP_PATH=/usr/bin/pg_dump
PG_RESTORE_PATH=/usr/bin/pg_restore
RUN_DATABASE_MIGRATIONS=true
RUN_DEMO_SEED=false

SUBSCRIPTION_ENFORCEMENT_ENABLED=true
DEVICE_PROVISIONING_ENABLED=true
ADMIN_DASHBOARD_KPI_ENABLED=true
ASSET_MANAGEMENT_ENABLED=true
LIVE_MONITORING_ENABLED=true
ALARM_CENTER_ENABLED=true
ALARM_ANALYTICS_ENABLED=true
ALARM_ESCALATION_ENABLED=true
ALARM_ESCALATION_QUEUE_ENABLED=true

TELEGRAM_ESCALATION_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_DEFAULT_TO=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

N8N_ENCRYPTION_KEY=CHANGE_ME
N8N_BASIC_AUTH_USER=factorybox
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME
N8N_PORT=5678
PGADMIN_DEFAULT_EMAIL=admin@factorybox.local
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME
PGADMIN_PORT=5050
