# FactoryBox customer installation — HukaTech Central Mail Gateway client
# Copy only these required values into .env.production. Do not replace the full production env file.
# The Brevo API key is NEVER stored on the customer computer.

EMAIL_REPORTS_ENABLED=true
FACTORYBOX_MAIL_MODE=gateway
FACTORYBOX_MAIL_GATEWAY_URL=https://mail.hukatech.com
FACTORYBOX_MAIL_INSTALLATION_ID=REPLACE_INSTALLATION_ID
FACTORYBOX_MAIL_API_KEY=REPLACE_REVOCABLE_GATEWAY_API_KEY
FACTORYBOX_MAIL_ALLOW_SMTP_FALLBACK=false
FACTORYBOX_MAIL_GATEWAY_TIMEOUT_MS=15000
FACTORYBOX_MAIL_SENDER_NAME=HukaTech | Customer Name

# Direct SMTP is intentionally not required on standard customer installations.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
