# HukaTech Central Mail Gateway server — Brevo API provider
# Copy this file as .env.mail-gateway on the centrally managed HukaTech server.
# Never place the Brevo API key in a customer installation or source control.

TZ=Europe/Istanbul
MAIL_GATEWAY_PORT=3101
FACTORYBOX_IMAGE_TAG=v6.10.0

MAIL_GATEWAY_PGDATABASE=hukatech_mail_gateway
MAIL_GATEWAY_PGUSER=hukatech_mail_gateway
MAIL_GATEWAY_PGPASSWORD=REPLACE_STRONG_DATABASE_PASSWORD

MAIL_GATEWAY_ONLY=true
MAIL_GATEWAY_SERVER_ENABLED=true
MAIL_GATEWAY_MAX_PER_MINUTE=30
MAIL_GATEWAY_MAX_PER_DAY=500

# Single-installation pilot.
# Store the SHA-256 hash centrally; the customer receives the original gateway key.
MAIL_GATEWAY_SINGLE_INSTALLATION_ID=REPLACE_INSTALLATION_ID
MAIL_GATEWAY_SINGLE_CUSTOMER_NAME=Customer Name
MAIL_GATEWAY_SINGLE_API_KEY_SHA256=REPLACE_SHA256_OF_GATEWAY_API_KEY
MAIL_GATEWAY_SINGLE_ENABLED=true

# Central provider — Brevo Transactional Email API.
MAIL_GATEWAY_PROVIDER=brevo_api
MAIL_GATEWAY_BREVO_API_BASE_URL=https://api.brevo.com/v3
MAIL_GATEWAY_BREVO_API_KEY=PASTE_BREVO_API_KEY_ONLY_ON_CENTRAL_SERVER
MAIL_GATEWAY_BREVO_TIMEOUT_MS=15000

# Verified HukaTech sender.
MAIL_GATEWAY_SENDER_NAME=HukaTech
MAIL_GATEWAY_FROM_EMAIL=noreply@hukatech.com

# Keep empty because this address is notification-only.
MAIL_GATEWAY_REPLY_TO=
MAIL_GATEWAY_NO_REPLY_TEXT=Bu e-posta HukaTech tarafından otomatik olarak gönderilmiştir. Lütfen bu e-postayı yanıtlamayın.

# Optional legacy SMTP provider. Not used when MAIL_GATEWAY_PROVIDER=brevo_api.
# MAIL_GATEWAY_PROVIDER=smtp
# MAIL_GATEWAY_SMTP_HOST=smtp.example.com
# MAIL_GATEWAY_SMTP_PORT=587
# MAIL_GATEWAY_SMTP_SECURE=false
# MAIL_GATEWAY_SMTP_USER=
# MAIL_GATEWAY_SMTP_PASS=
# MAIL_GATEWAY_SMTP_FROM=noreply@hukatech.com

# Multi-customer alternative:
# MAIL_GATEWAY_INSTALLATIONS_JSON={"customer-a":{"api_key_sha256":"...","customer_name":"Customer A","enabled":true,"max_per_minute":30,"max_per_day":500}}
# v6.10.0 Customer Installation Registry administrator (HukaTech pilot only)
MAIL_GATEWAY_SINGLE_CUSTOMER_CODE=hukatech-pilot
MAIL_GATEWAY_SINGLE_PUBLIC_HOSTNAME=panel.hukatech.com
MAIL_GATEWAY_SINGLE_TUNNEL_NAME=hukatech-platform-production
MAIL_GATEWAY_SINGLE_REGISTRY_ADMIN=true
MAIL_GATEWAY_SINGLE_MAX_PER_MINUTE=30
MAIL_GATEWAY_SINGLE_MAX_PER_DAY=500
MAIL_GATEWAY_PUBLIC_URL=REPLACE_WITH_PUBLIC_GATEWAY_URL
